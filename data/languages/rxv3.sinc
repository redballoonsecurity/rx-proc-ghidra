	SP = SP - 4; *:4 SP = DECNT;
	SP = SP - 4; *:4 SP = DCMR;
}
:DPUSHM.L "DECNT-DECNT"  is v3op = 0x75; v3op = 0xA0; v3hi = 2 & v3lo = 0 {
