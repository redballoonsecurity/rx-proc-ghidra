:DPUSHM.D "DR0-DR8"  is v3op = 0x75; v3op = 0xB0; v3hi = 0 & v3lo = 8 {
	SP = SP - 8; *:8 SP = DR8;
	SP = SP - 8; *:8 SP = DR7;
