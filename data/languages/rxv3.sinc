## MVFDC DCRs, Rd                 FD 75 | 8 rd | cr 0100
:MVFDC dcr_hi, gr1_lo  is v3op = 0xFD; v3op = 0x75; v3hi = 0x8 & gr1_lo; dcr_hi & v3hi < 4 & v3lo = 0x4 {
	gr1_lo = dcr_hi;
}
## MVTDC Rs, DCRd                 FD 77 | 8 rs | cr 0100
:MVTDC gr1_lo, dcr_hi  is v3op = 0xFD; v3op = 0x77; v3hi = 0x8 & gr1_lo; dcr_hi & v3hi < 4 & v3lo = 0x4 {
	dcr_hi = gr1_lo;
}
## MVFDR                          75 90 1B    (PSW.Z = DCMR.RES)
:MVFDR  is v3op = 0x75; v3op = 0x90; v3op = 0x1B {
	$(Z_flag) = $(DCMR_RES);
}

################################################################
# Double-precision arithmetic
#   two operands:   76 90 | rs  op1 | rd  op2
#   three operands: 76 90 | rs2 op  | rd  rs      (syntax: Dxxx src, src2, dest)
################################################################

:DADD dr2_lo, dr1_hi, dr2_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0x0; dr2_hi & dr2_lo {
	dr2_hi = dr1_hi f+ dr2_lo;
}
:DSUB dr2_lo, dr1_hi, dr2_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0x1; dr2_hi & dr2_lo {
	dr2_hi = dr1_hi f- dr2_lo;
}
:DMUL dr2_lo, dr1_hi, dr2_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0x2; dr2_hi & dr2_lo {
	dr2_hi = dr1_hi f* dr2_lo;
}
:DDIV dr2_lo, dr1_hi, dr2_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0x5; dr2_hi & dr2_lo {
	dr2_hi = dr1_hi f/ dr2_lo;
}

## DCMPcm src, src2: DCMR.RES = (src2 cm src)
:DCMPUN dr2_lo, dr1_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0x8; cm = 0x1 & dr2_lo {
	$(DCMR_RES) = nan(dr1_hi) || nan(dr2_lo);
}
:DCMPEQ dr2_lo, dr1_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0x8; cm = 0x2 & dr2_lo {
	$(DCMR_RES) = dr1_hi f== dr2_lo;
}
:DCMPLT dr2_lo, dr1_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0x8; cm = 0x4 & dr2_lo {
	$(DCMR_RES) = dr1_hi f< dr2_lo;
}
:DCMPLE dr2_lo, dr1_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0x8; cm = 0x6 & dr2_lo {
	$(DCMR_RES) = dr1_hi f<= dr2_lo;
}

:DABS dr1_hi, dr2_hi    is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0xC; dr2_hi & v3lo = 0x1 {
	dr2_hi = abs(dr1_hi);
}
:DNEG dr1_hi, dr2_hi    is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0xC; dr2_hi & v3lo = 0x2 {
	dr2_hi = f- dr1_hi;
}
:DSQRT dr1_hi, dr2_hi   is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0xD; dr2_hi & v3lo = 0x0 {
	dr2_hi = sqrt(dr1_hi);
}

## Conversions from double: the 32-bit result goes to the lower half of DRd, the upper half is undefined
:DTOI dr1_hi, dr2_hi    is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0xD; dr2_hi & drl_hi & v3lo = 0x8 {
	drl_hi = trunc(dr1_hi);
}
:DTOU dr1_hi, dr2_hi    is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0xD; dr2_hi & drl_hi & v3lo = 0x9 {
	local tmp:8 = trunc(dr1_hi);
	drl_hi = tmp:4;
}
:DTOF dr1_hi, dr2_hi    is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0xD; dr2_hi & drl_hi & v3lo = 0xC {
	drl_hi = float2float(dr1_hi);
}
:DROUND dr1_hi, dr2_hi  is v3op = 0x76; v3op = 0x90; dr1_hi & v3lo = 0xD; dr2_hi & drl_hi & v3lo = 0xD {
	drl_hi = dround(dr1_hi);
}

## Conversions to double              FD 77 | 8 rs | rd op
:FTOD gr1_lo, dr2_hi    is v3op = 0xFD; v3op = 0x77; v3hi = 0x8 & gr1_lo; dr2_hi & v3lo = 0xA {
	dr2_hi = float2float(gr1_lo);
}
:ITOD gr1_lo, dr2_hi    is v3op = 0xFD; v3op = 0x77; v3hi = 0x8 & gr1_lo; dr2_hi & v3lo = 0x9 {
	dr2_hi = int2float(gr1_lo);
}
:UTOD gr1_lo, dr2_hi    is v3op = 0xFD; v3op = 0x77; v3hi = 0x8 & gr1_lo; dr2_hi & v3lo = 0xD {
	local tmp:8 = zext(gr1_lo);
	dr2_hi = int2float(tmp);
}
