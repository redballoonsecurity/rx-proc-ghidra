:DPUSHM.L "DPSW-DPSW"  is v3op = 0x75; v3op = 0xA0; v3hi = 0 & v3lo = 0 {
	SP = SP - 4; *:4 SP = DPSW;
}
:DPUSHM.L "DPSW-DCMR"  is v3op = 0x75; v3op = 0xA0; v3hi = 0 & v3lo = 1 {
	SP = SP - 4; *:4 SP = DCMR;
	SP = SP - 4; *:4 SP = DPSW;
}
:DPUSHM.L "DPSW-DECNT"  is v3op = 0x75; v3op = 0xA0; v3hi = 0 & v3lo = 2 {
	SP = SP - 4; *:4 SP = DECNT;
	SP = SP - 4; *:4 SP = DCMR;
	SP = SP - 4; *:4 SP = DPSW;
}
:DPUSHM.L "DPSW-DEPC"  is v3op = 0x75; v3op = 0xA0; v3hi = 0 & v3lo = 3 {
	SP = SP - 4; *:4 SP = DEPC;
	SP = SP - 4; *:4 SP = DECNT;
	SP = SP - 4; *:4 SP = DCMR;
	SP = SP - 4; *:4 SP = DPSW;
}
:DPUSHM.L "DCMR-DCMR"  is v3op = 0x75; v3op = 0xA0; v3hi = 1 & v3lo = 0 {
	SP = SP - 4; *:4 SP = DCMR;
}
:DPUSHM.L "DCMR-DECNT"  is v3op = 0x75; v3op = 0xA0; v3hi = 1 & v3lo = 1 {
