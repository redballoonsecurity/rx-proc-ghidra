<opinions>
    <!-- EM_RX = 173. RXv3 is a superset of RXv1/RXv2, so it is the default for RX ELF files;
         pick RX:LE:32:RXv2 manually to restrict decoding to the RXv2 instruction set. -->
    <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
        <constraint primary="173" processor="RX" endian="little" size="32" variant="RXv3" />
    </constraint>
</opinions>
